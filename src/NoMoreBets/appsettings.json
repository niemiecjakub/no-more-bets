{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Scraper": {
    "DelaySeconds": 5.0,
    "RetryCount": 3,
    "RetryDelaySeconds": 2.0,
    "TimeoutSeconds": 15.0,
    "Fotmob": {
      "LeagueId": 47,
      "LeagueSlug": "premier-league"
    }
  },
  "StorageCache": {
    "JsonCache": {
      "StoreFolder": "cache/json",
      "Store": true,
      "UseCache": true,
      "CacheTtlSeconds": 86400
    },
    "HtmlCache": {
      "StoreFolder": "cache/html",
      "Store": true,
      "UseCache": true,
      "CacheTtlSeconds": 3600
    }
  }
}
