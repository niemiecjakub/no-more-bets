{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Scraper": {
    "DelaySeconds": 5.0,
    "RetryCount": 3,
    "RetryDelaySeconds": 2.0,
    "TimeoutSeconds": 15.0,
    "Fotmob": {
      "LeagueId": 47,
      "LeagueSlug": "premier-league"
    }
  },
  "SoccerData": {
    "RetryCount": 3,
    "RetryDelaySeconds": 2.0,
    "TimeoutSeconds": 15.0,
    "ApiKey": ""
  },
  "MatchAnalysis": {
    "LeagueId": 228,
    "OutputDirectory": "Output"
  },
  "StorageCache": {
    "JsonCache": {
      "StoreFolder": "Cache/json",
      "Store": true,
      "UseCache": true,
      "CacheTtlSeconds": 2000000000
    },
    "HtmlCache": {
      "StoreFolder": "Cache/html",
      "Store": true,
      "UseCache": true,
      "CacheTtlSeconds": 2000000000
    }
  }
}
